{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/dispatch.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/hooks/dispatch.py\"",
            "timeout": 10,
            "additionalContextLimit": 2500
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/dispatch.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/hooks/dispatch.py\"",
            "timeout": 10,
            "additionalContextLimit": 2500
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/dispatch.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/hooks/dispatch.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/dispatch.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/hooks/dispatch.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/dispatch.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/hooks/dispatch.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/dispatch.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/hooks/dispatch.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/dispatch.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/hooks/dispatch.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/dispatch.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/hooks/dispatch.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
